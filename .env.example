# ============================================================
# TOTVS RM Educacional (API TTALK REST) - OPCIONAL/DESATIVADO
# ============================================================
# No CloudTOTVS o REST educacional em geral NAO esta publicado; a fonte de dados
# do RM e o wsConsultaSQL (SOAP) abaixo. Deixe vazio. Se o REST existir, preencha
# TOTVS_RM_HOST + TOTVS_RM_AUTH_HEADER (valor COMPLETO, ex.: "Basic <base64>").
TOTVS_RM_HOST=
TOTVS_RM_AUTH_HEADER=
TOTVS_RM_PAGE_SIZE=200

# Códigos de MajorStatus/TermStatus considerados "aluno ativo" (CSV).
# Os domínios NÃO são documentados nos specs - levante no seu ambiente.
# Vazio = aceita todos os contextos.
RM_ACTIVE_TERM_STATUSES=

# ============================================================
# TBC / wsConsultaSQL (SOAP) - FONTE DE DADOS DO RM.
# Endpoint {RM_WS_BASEURL}/wsConsultaSQL/IwsConsultaSQL, auth HTTP Basic com
# USUARIO DO RM (nao do banco). Executa Sentencas SQL cadastradas no RM.
# ============================================================
RM_WS_BASEURL=https://SEU_TENANT.rm.cloudtotvs.com.br:1951
RM_WS_USER=
RM_WS_PASS=
RM_CODCOLIGADA=1
# Periodo letivo passado a Sentenca de alunos (parametro CODPERLET)
RM_CODPERLET=2026
# Campus (CODFILIAL) no escopo da integracao, em CSV. VAZIO = TODOS os campi.
# Nesta escola: 1 = Infantil + Fundamental I (FORA do escopo do Toddle);
#               2 = campus do aeroporto, Fundamental II + Medio (no escopo).
# Alunos de campus fora da lista sao descartados no extract, com contagem no log.
RM_CODFILIAL=2

# Codigos das Sentencas SQL cadastradas no RM (preencher apos o admin criar).
# FLUXO 1 (obrigatoria): roster de alunos ATIVOS. Colunas: RA, NOME_COMPLETO
#   (obrigatorias) + opcionais COD_TURMA (resolve yearGroup), CODCURSO,
#   CODINTERNO, EMAIL, EMAIL_PESSOAL, DTNASCIMENTO, SEXO. A propria Sentenca
#   filtra ativos no SQL. Recebe parametros CODCOLIGADA e CODPERLET.
RM_SENTENCA_STUDENTS=
# FLUXO 2 (roadmap):
RM_SENTENCA_FREQUENCIA=
RM_SENTENCA_NOTAS=
# Sistema RM das sentencas educacionais (normalmente "S")
RM_WS_SISTEMA=S

# ============================================================
# Toddle Open API V2 (Toddle 1.0)
# ============================================================
# Regiao do tenant (eu-west-1, us-east-1, eu-central-1, ap-southeast-2, ap-southeast-1, cn-north-1)
TODDLE_REGION=us-east-1

# Opcional: sobrescreve a URL completa (senao e montada pela regiao)
TODDLE_BASE_URL=

# Bearer token fornecido pela equipe do Toddle a escola
TODDLE_TOKEN=

# GET /students exige paginacao; pageSize entre 100 e 400
TODDLE_PAGE_SIZE=400

# Fallback quando nao houver mapeamento YEAR_GROUP na id_mapping
TODDLE_DEFAULT_YEAR_GROUP_ID=

# ============================================================
# Integracao
# ============================================================
# Prefixo do sourceId enviado ao Toddle (ex.: "1-" para prefixar a coligada).
# Escolha UM formato e NUNCA mude - e ele que garante o upsert idempotente.
SOURCE_ID_PREFIX=
SYNC_BATCH_SIZE=50
# Cron da sincronizacao noturna de alunos
STUDENTS_SYNC_CRON=0 3 * * *

# ============================================================
# Infra do middleware
# ============================================================
# porta 5433 = mapeamento do docker-compose (host 5433 -> container 5432)
DATABASE_URL=postgres://middleware:middleware@localhost:5433/rm_toddle
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
NODE_ENV=development
