# ============================================================
# TOTVS RM Educacional (API TTALK REST) - OPCIONAL/DESATIVADO
# ============================================================
# No CloudTOTVS o REST educacional em geral NAO esta publicado; a fonte de dados
# do RM e o wsConsultaSQL (SOAP) abaixo. Deixe vazio. Se o REST existir, preencha
# TOTVS_RM_HOST + TOTVS_RM_AUTH_HEADER (valor COMPLETO, ex.: "Basic <base64>").
TOTVS_RM_HOST=
TOTVS_RM_AUTH_HEADER=
TOTVS_RM_PAGE_SIZE=200

# Codigos de SMATRICPL.CODSTATUS considerados "aluno ativo" (CSV).
# FALLBACK apenas: se a Sentenca devolver STATUS_ATIVO (SSTATUS.PLATIVO), o
# middleware usa esse flag do proprio RM e ignora esta lista. Preencha so se a
# Sentenca NAO expuser o flag.
# Nesta base, PLATIVO='S' cobre 4 status: Matriculado, Matricula em andamento,
# Matricula nao enturmado e Aluno Visitante. Atencao: a query do Destiny usa
# CODSTATUS IN (1,2,20) - tres codigos, nao quatro. As duas definicoes de
# "ativo" divergem; confirme qual esta certa antes de preencher aqui.
# Vazio = aceita todos (quando o flag tambem estiver ausente).
RM_ACTIVE_TERM_STATUSES=

# ============================================================
# TBC / wsConsultaSQL (SOAP) - FONTE DE DADOS DO RM.
# Endpoint {RM_WS_BASEURL}/wsConsultaSQL/IwsConsultaSQL, auth HTTP Basic com
# USUARIO DO RM (nao do banco). Executa Sentencas SQL cadastradas no RM.
# ============================================================
RM_WS_BASEURL=https://SEU_TENANT.rm.cloudtotvs.com.br:1951
RM_WS_USER=
RM_WS_PASS=
RM_CODCOLIGADA=1
# Periodo letivo passado a Sentenca de alunos (parametro CODPERLET)
RM_CODPERLET=2026
# Campus (CODFILIAL) no escopo da integracao, em CSV. VAZIO = TODOS os campi.
# Nesta escola: 1 = Infantil + Fundamental I (FORA do escopo do Toddle);
#               2 = campus do aeroporto, Fundamental II + Medio (no escopo).
# Alunos de campus fora da lista sao descartados no extract, com contagem no log.
RM_CODFILIAL=2

# Codigos das Sentencas SQL cadastradas no RM (preencher apos o admin criar).
# FLUXO 1 (obrigatoria): roster de alunos ATIVOS. Colunas: RA, NOME_COMPLETO
#   (obrigatorias) + opcionais COD_TURMA (resolve yearGroup), CODCURSO,
#   CODINTERNO, EMAIL, EMAIL_PESSOAL, DTNASCIMENTO, SEXO. A propria Sentenca
#   filtra ativos no SQL. Recebe parametros CODCOLIGADA e CODPERLET.
RM_SENTENCA_STUDENTS=
# TURMA/PROFESSOR/DISCIPLINA: uma linha por turma-disciplina-professor.
# Alimenta staff, subjects, teacher-courses e classes. Recebe CODCOLIGADA e
# CODPERLET. Ver docs/rm-sentencas/TODDLE.TURMADISC.V1.sql
RM_SENTENCA_TURMADISC=
# FLUXO 2 (roadmap):
RM_SENTENCA_FREQUENCIA=
RM_SENTENCA_NOTAS=
# Sistema RM das sentencas educacionais (normalmente "S")
RM_WS_SISTEMA=S

# Recolocar sozinho a Sentenca que SUMIU do RM, quando um job esbarrar nela.
# Toda copia de base por cima do ambiente apaga as seis (13-15/08, 16/09 e
# 20/09/2026) e o conteudo mora em docs/rm-sentencas/*.sql, versionado.
# Default true. So restaura o que esta AUSENTE: Sentenca presente e divergente
# nao e sobrescrita sozinha - isso continua sendo o botao do painel, porque o RM
# pode estar a frente do repositorio.
SENTENCAS_AUTO_RESTAURO=true

# ============================================================
# Toddle Open API V2 - modelo 2.0 / TeacherCourse
# CONFERIDO em GET /curriculums (2026-07-31): os dois curriculos da EAV vem com
# isTeacherCourseEnabled=true e gradebookVersion=2. Turma NAO e POST /courses -
# e POST /teacher-courses e depois POST /classes com o teacherCourseId.
# attendanceVersion segue "1", ou seja, config MISTA: gradebook 2 nao implica
# Attendance V4. Reconfirme com o token do ambiente antes de escrever turma.
# ============================================================
# Regiao do tenant (eu-west-1, us-east-1, eu-central-1, ap-southeast-2, ap-southeast-1, cn-north-1)
TODDLE_REGION=us-east-1

# Organizacao Toddle de destino. OBRIGATORIA - sem ela o processo aborta.
# O cliente compara com a org que a API devolve e ABORTA se divergir, ANTES de
# qualquer escrita: trocar o token sem trocar o de-para escreveria noutra
# organizacao reusando ids que nao existem la.
# Tambem e a target_instance_key da id_mapping, entao o mesmo RA pode ter
# mapeamento no sandbox e na org final sem colidir.
TODDLE_ORG_ID=

# Opcional: sobrescreve a URL completa (senao e montada pela regiao)
TODDLE_BASE_URL=

# Bearer token fornecido pela equipe do Toddle a escola
TODDLE_TOKEN=

# GET /students exige paginacao; pageSize entre 100 e 400
TODDLE_PAGE_SIZE=400

# Fallback quando nao houver mapeamento YEAR_GROUP na id_mapping
TODDLE_DEFAULT_YEAR_GROUP_ID=

# ============================================================
# Integracao
# ============================================================
# Prefixo do sourceId enviado ao Toddle (ex.: "1-" para prefixar a coligada).
# Escolha UM formato e NUNCA mude - e ele que garante o upsert idempotente.
SOURCE_ID_PREFIX=
SYNC_BATCH_SIZE=50

# De quantos em quantos dias um aluno e reenviado ao Toddle MESMO sem ter mudado
# no RM. O sync pula escrita identica (migracao 021) e isso corta ~96% das
# chamadas - mas tambem faz edicao manual no Toddle sobreviver. Esta janela e o
# teto dessa divergencia. 0 desliga o reenvio periodico. Padrao: 7.
SYNC_REENVIO_DIAS=7
# Cron do sync de alunos - agora e SEMENTE, nao configuracao em vigor.
#
# A verdade do horario passou para a tabela flow_schedule (migration 016), e a
# tela e quem muda. Este valor vale UMA vez: na primeira subida, quando a linha
# do fluxo ainda nao existe. Depois disso, alterar aqui NAO muda nada.
#
# A precedencia e de uma via de proposito. Se o ambiente vencesse quando
# presente, o proximo deploy desfaria em silencio o que alguem mudou pela tela -
# com a tela mostrando o valor novo por cima. Para conferir o que esta em vigor:
# `npm run agenda`.
#
# O cron do PROFESSOR e derivado deste somando 30 min, tambem so como semente. A
# folga de 30 min existe porque a janela de rate limit do Toddle e de 300s e os
# dois falam com a mesma organizacao; a partir da tela ela e VERIFICADA a cada
# mudanca, em vez de calculada.
STUDENTS_SYNC_CRON=0 3 * * *

# Guarda de desvio de contagem, em pontos percentuais.
#
# O sync e COMPLETO: se o RM voltar a servir uma copia ANTIGA da base - que
# aconteceu em 13-15/08/2026 - ele sobrescreveria os alunos no Toddle com dado
# velho, reportando failed=0 e sem um unico log de erro. Esta e a unica defesa
# contra isso: o run aborta ANTES de escrever se a contagem em escopo variar
# mais que este teto em relacao ao ultimo run bem-sucedido.
#
# Falha para o lado de NAO ESCREVER, de proposito: run abortado se auto-cura no
# proximo cron; aluno sobrescrito com dado de outra base, nao.
# 0 = desligado.
SYNC_DESVIO_MAX_PCT=10

# ============================================================
# Teto de volume da ESCRITA no RM
# ============================================================
# As guardas por REGISTRO (decidirEscrita) sao cegas para "quantas?".
#
# Um JOIN errado no de-para virando produto cartesiano, ou um periodo letivo
# divergente fazendo tudo parecer "faltando no RM", produz MILHARES de decisoes
# individualmente CORRETAS — cada linha realmente nao esta la. O erro so existe
# no agregado, e este e o unico ponto do sistema que olha o agregado.
#
# Acima disto o run e RECUSADO, nao "precisa aprovacao": um plano deste tamanho e
# evidencia de defeito estrutural, e um humano clicando aprovar em 50.000 linhas
# nao esta dando consentimento informado.
WRITE_TETO_ABSOLUTO=5000
# Percentual acima do historico que exige aprovacao humana.
WRITE_DESVIO_MAX_PCT=50
# Percentual do escopo da janela que, sozinho, exige aprovacao.
WRITE_TETO_ESCOPO_PCT=30
# Abaixo disto nunca pede aprovacao. Percentual sobre numero pequeno e ruido:
# 2 -> 6 linhas e +200% e nao significa nada. Sem o piso, correcao miuda viraria
# pedido de aprovacao — e aprovacao que aparece por nada e aprovacao que alguem
# passa a dar sem ler.
WRITE_PISO_SEM_APROVACAO=50

# ============================================================
# Alerta por AUSENCIA de sucesso (dead man's switch)
# ============================================================
# URL de um monitor externo (Healthchecks.io, Uptime Kuma, ntfy...). O job pinga
# ao terminar; o SERVICO EXTERNO alerta quando o ping NAO chega.
#
# A inversao e o ponto inteiro. Entre 12 e 20/08/2026 a integracao ficou 8 dias
# morta e ninguem soube - um alerta construido DENTRO deste processo nao teria
# disparado, porque o processo era justamente o que estava parado. Alerta por
# silencio sobrevive a container morto, Redis fora, senha expirada e Sentenca
# apagada.
#
# Vazias = desligado. Ninguem e obrigado a ter monitor.
#
# LIMIAR, do lado do monitor: o cron roda 4x ao dia mas com intervalos
# DESIGUAIS - 03:00, 09:00, 12:00, 16:00 deixa uma janela de 11h entre 16:00 e
# 03:00. Limiar de 8h alertaria toda madrugada, e alerta que grita por nada
# passa a ser ignorado. Use ~13h (ou 12h + 1h de folga).
HEARTBEAT_URL_ALUNOS=
HEARTBEAT_URL_PROFESSORES=
# Lido pelo scripts/pull-backup-coolify.sh (shell, nao passa pelo Zod).
# O backup falhou calado em 15/08, 16/08 e 21/08/2026.
HEARTBEAT_URL_BACKUP=
HEARTBEAT_TIMEOUT_MS=5000

# ============================================================
# Plano de controle: alerta ativo e reconciliacao da agenda
# ============================================================
# Webhook de alerta (Slack, Discord, ntfy, Teams). Vazio = desligado.
#
# COMPLEMENTAR ao heartbeat, nao substituto, e a diferenca importa:
#
#   heartbeat  um terceiro reclama do SILENCIO. Cobre este processo MORTO -
#              container caido, Redis fora, senha expirada, deploy quebrado.
#   este       o processo fala. Cobre o que o silencio nao pega: job que morre
#              com o worker VIVO. Foi esse o caso dos 62 registros na DLQ, sete
#              dias sem ninguem saber.
#
# Nenhum dos dois sozinho cobre os dois modos de falha.
ALERTA_WEBHOOK_URL=
ALERTA_WEBHOOK_TIMEOUT_MS=5000

# Intervalo do poll de reconciliacao da agenda, em ms (minimo 5000).
#
# A tela grava a intencao no Postgres e avisa o worker por pub/sub; este poll e
# o PISO. Pub/sub e entrega no maximo uma vez: se o aviso se perder (worker
# reiniciando, Redis reiniciando - os cenarios que ja custaram caro aqui), o
# poll converge sozinho. Nao remova "porque o pub/sub avisa": a falha volta, e
# volta silenciosa.
AGENDA_RECONCILIA_MS=60000

# Intervalo minimo entre dois disparos que a tela aceita salvar, em minutos.
#
# Guarda contra o "* * * * *" digitado por engano. Com concurrency 1 o sintoma
# nao seria execucao concorrente, e sim BACKLOG crescente - a fila enche mais
# rapido do que o worker consome, e o atraso aparece horas depois, longe da
# causa. Cada passada de nota le ~7 mil linhas de Sentenca no RM.
AGENDA_INTERVALO_MIN_MINUTOS=15

# Intervalo do vigia de "nenhum sucesso na janela", em ms (minimo 60000).
#
# Ele pergunta pelo ultimo SUCESSO, nao pelo ultimo run: um fluxo que falha de
# hora em hora tem "ultimo run" recentissimo e esta morto ha dias.
VIGIA_INTERVALO_MS=900000

# ============================================================
# Infra do middleware
# ============================================================
# porta 5433 = mapeamento do docker-compose (host 5433 -> container 5432)
DATABASE_URL=postgres://middleware:middleware@localhost:5433/rm_toddle
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
NODE_ENV=development

# ============================================================
# API (plano de controle)
# ============================================================
# OBRIGATORIA e sem default: a API expoe dados de alunos (PII), e "esqueci de
# configurar" nao pode virar "aberta".
#   google-oidc  producao: exige Bearer token do Google; valida assinatura
#                (JWKS), audience, expiracao e a claim `hd` do Workspace.
#   localhost    desenvolvimento: dispensa token, mas SO escuta em 127.0.0.1,
#                recusa subir com NODE_ENV=production e loga aviso em TODA
#                requisicao.
API_AUTH_MODE=localhost
API_PORT=3333
API_HOST=127.0.0.1
# Origens autorizadas a chamar a API (CORS), CSV. Allowlist explicita, nunca "*":
# a UI manda o header Authorization, e com origem aberta qualquer pagina no
# navegador do usuario poderia usar o token dele contra esta API.
# localhost e 127.0.0.1 sao origens DIFERENTES para o navegador e para o Google.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exigidos quando API_AUTH_MODE=google-oidc:
# GOOGLE_CLIENT_ID e o `aud` esperado no token.
GOOGLE_CLIENT_ID=
# Dominios do Workspace aceitos (claim `hd`), CSV. Sem isso qualquer conta
# Google entraria. Validar por `hd` e nao pelo sufixo do e-mail e deliberado:
# e-mail e um campo, `hd` e asserção do provedor.
GOOGLE_ALLOWED_HD=escolaamericana.com.br

# ============================================================
#  VIA DE NOTA — Toddle -> TOTVS RM (escrita AGENDADA)
# ============================================================
# A ÚNICA escrita automática que este middleware faz no RM. Todas as outras
# exigem alguém digitando `--executar`.
#
# Desligada por default DE PROPÓSITO: o middleware é white label, e escrita
# automática em registro acadêmico legal não pode chegar numa escola nova por
# herança de default. Vale também como interruptor — `false` + redeploy remove o
# agendamento do Redis.
NOTA_SYNC_ATIVO="false"

# Frequência do poll. A API do Toddle NÃO tem webhook, então "quando o professor
# lançar" é necessariamente uma consulta periódica. O default cobre 6h-22h de
# meia em meia hora: fora disso ninguém lança nota, e cada passada custa uma
# leitura da Sentença TODDLE.NOTAS no RM.
# Tambem SEMENTE (ver STUDENTS_SYNC_CRON): vale na PRIMEIRA subida, quando a
# linha do fluxo ainda nao existe em `flow_schedule`. Depois disso o banco manda
# e a tela de Agenda e que decide horario e liga/desliga.
#
# (O aviso antigo de "fluxo bloqueado no catalogo" saiu porque deixou de ser
# verdade: a via foi desbloqueada em 11/09/2026, quando o destino passou a ser a
# AVALIACAO -- SProvas + SNotas -- em vez do EduNotaEtapaData, que aceitava e
# descartava o valor.)
NOTA_SYNC_CRON="*/30 6-22 * * *"

# Recusar nota cuja etapa esteja com SETAPAS.DISPONIVELALUNOS='N'?
#
# `false` de propósito. A guarda nasceu do fluxo INVERSO (RM -> Toddle), onde
# escrever significava PUBLICAR nota provisória para a família. Nesta direção
# não: DISPONIVELALUNOS é a flag DO RM que controla o que o aluno vê, e gravar em
# etapa não liberada deixa a nota no banco sem exibi-la a ninguém.
#
# Com `true`, a via não escreve NADA na EAV: a flag vem 'N' em 100% das 7.268
# notas medidas.
NOTA_EXIGIR_ETAPA_LIBERADA="false"

# Monitor da via de nota (mesmo padrão dos outros). Vazio = sem alerta: se a via
# parar, a escola vai supor que o boletim está sincronizado enquanto não está.
HEARTBEAT_URL_NOTAS=""

# --- Turma e disciplina, RM -> de-para (SOMENTE LEITURA) --------------------
#
# Compara as turma-disciplina do RM com o de-para e relata a deriva: turma nova
# com aluno, turma reativada, turma que sumiu. NAO cria e NAO arquiva nada.
#
# Nao tem interruptor de escola porque nao escreve. O que ele resolve e a deriva
# ficar INVISIVEL: os 186 COURSE vieram de carga manual e nada os atualiza --
# foi assim que a turma 1714 ficou de fora com 60 faltas lancadas.
#
# 05:00 e escolhido, nao sorteado: alunos roda 03:00/09:00, professores
# 03:30/09:30 e a nota das 06:00 as 22:00. E o unico horario que nao encosta em
# nenhum dos tres na janela de 300s do Toddle.
TURMAS_SYNC_CRON="0 5 * * *"

# --- Via de FREQUENCIA, Toddle -> RM (automatica) ---------------------------
#
# A SEGUNDA escrita agendada em registro academico, e a mais delicada: o TOTVS e
# a fonte de verdade da frequencia e ja tem ~14,6 mil faltas lancadas a mao. E
# `PRESENCA='P'` nao sobrescreve um valor -- ele REMOVE a linha da SFREQUENCIA,
# ou seja, escrever "presente" por engano APAGA a falta que um professor lancou.
#
# Default `false` pelo mesmo motivo de NOTA_SYNC_ATIVO. Ligar aqui e so metade:
# o fluxo `attendance.sync` tambem precisa estar ativo na tela de Agenda.
FREQ_SYNC_ATIVO="false"

# 23:00, uma vez por dia. A chamada e lancada ao longo do dia e nao ha webhook;
# rodar de madrugada pega o dia inteiro fechado, em vez de escrever meia aula e
# voltar depois. Tambem SEMENTE.
FREQ_SYNC_CRON="0 23 * * *"

# Quantos dias para tras a passada reprocessa. NAO e "desde a ultima vez": a
# janela fixa torna cada passada idempotente e independente do historico --
# perder uma noite nao perde dado, porque a noite seguinte cobre o mesmo
# intervalo. Tres dias cobre o fim de semana.
FREQ_SYNC_DIAS="3"

# --- TEMPO QUASE REAL: detectores de mudanca --------------------------------
#
# Liga/desliga, intervalo e horario de cada detector moram na tabela
# `fluxo_continuo` (migration 022) e mudam pela tela (aba Agenda, "Tempo quase
# real"). Linha nova nasce DESLIGADA. O que fica aqui e o que nao e decisao de
# operacao. Ver a D11 em docs/DECISOES.md.
#
# Fuso do relogio do servidor do RM: o RECMODIFIEDON vem sem fuso.
CONTINUO_RM_FUSO="America/Sao_Paulo"
# Sobreposicao entre uma consulta e a anterior, em minutos. Repetir linha e
# barato (a memoria descarta); perder linha nao e.
CONTINUO_FOLGA_MIN="10"
# Pausa do detector de cadastro depois de o RM recusar a credencial. O RM
# bloqueia o usuario depois de ~6 recusas seguidas; insistir de minuto em minuto
# chegaria la em seis minutos.
CONTINUO_PAUSA_CREDENCIAL_MIN="30"

# Monitor da via de frequencia. Vazio = sem alerta: se ela parar, a falta
# lancada no Toddle simplesmente nao chega ao RM, e o calculo dos 75% usa o que
# existe.
HEARTBEAT_URL_FREQUENCIA=""
