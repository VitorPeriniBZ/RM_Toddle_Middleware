{
  "name": "rm-toddle-middleware",
  "version": "0.1.0",
  "description": "Middleware de integração assíncrona TOTVS RM Educacional <-> Toddle (Open API V2)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "worker:students": "tsx apps/worker/src/workers/rm-to-toddle/studentSync.worker.ts",
    "enqueue:students": "tsx apps/worker/src/scripts/enqueueStudentSync.ts",
    "schedule": "tsx apps/worker/src/scripts/scheduleJobs.ts",
    "seed:yeargroups": "tsx apps/worker/src/scripts/seedYearGroups.ts",
    "check:student": "tsx apps/worker/src/scripts/checkStudent.ts",
    "dlq": "tsx apps/worker/src/scripts/dlq.ts",
    "api": "tsx apps/api/src/server.ts",
    "web": "npm run dev --workspace @rm-toddle/web",
    "typecheck:web": "npm run typecheck --workspace @rm-toddle/web",
    "shadow:frequencia": "tsx apps/worker/src/scripts/shadowAttendance.ts",
    "seed:periodos": "tsx apps/worker/src/scripts/seedPeriodos.ts",
    "seed:timetable": "tsx apps/worker/src/scripts/seedTimetable.ts",
    "seed:routine": "tsx apps/worker/src/scripts/seedRoutine.ts",
    "ler:frequencia": "tsx apps/worker/src/scripts/lerFrequenciaRm.ts",
    "ler:responsaveis": "tsx apps/worker/src/scripts/lerResponsaveis.ts",
    "sync:responsaveis": "tsx apps/worker/src/scripts/syncResponsaveis.ts",
    "seed:gradingperiods": "tsx apps/worker/src/scripts/seedGradingPeriods.ts",
    "ler:notas": "tsx apps/worker/src/scripts/lerNotas.ts",
    "reconciliar:turmas": "tsx apps/worker/src/scripts/reconciliarTurmas.ts",
    "criar:1714": "tsx apps/worker/src/scripts/criarTurma1714.ts",
    "reconciliar:professores": "tsx apps/worker/src/scripts/reconciliarProfessores.ts",
    "sync:professores": "tsx apps/worker/src/scripts/syncProfessores.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.7",
    "ioredis": "^5.4.2",
    "mssql": "^11.0.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
