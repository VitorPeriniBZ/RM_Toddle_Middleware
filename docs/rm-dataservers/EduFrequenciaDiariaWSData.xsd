<?xml version="1.0" ?>
<xs:schema xmlns:mstns="http://tempuri.org/EduFrequenciaDiaria.xsd" xmlns="http://tempuri.org/EduFrequenciaDiaria.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" id="EduFrequenciaDiaria" targetNamespace="http://tempuri.org/EduFrequenciaDiaria.xsd" attributeFormDefault="qualified" elementFormDefault="qualified">
  <xs:element name="EduFrequenciaDiaria" msdata:IsDataSet="true" msdata:UseCurrentLocale="true" msdata:EnforceConstraints="False">
    <xs:complexType>
