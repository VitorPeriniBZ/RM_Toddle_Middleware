          <xs:complexType>
            <xs:sequence>
              <xs:element name="CODCOLIGADA" msdata:Caption="Coligada" type="xs:short" default="1"/>
              <xs:element name="IDHORARIOTURMA" msdata:Caption="Identificador do horário da turma" type="xs:int"/>
              <xs:element name="IDTURMADISC" msdata:Caption="Turma disciplina" type="xs:int"/>
              <xs:element name="RA" msdata:Caption="R.A.">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="20"/>
